{
  "name": "photoflow",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "Streamlined publish/subscribe workflow for photographers and media teams covering live events.",
  "keywords": [
    "photography",
    "event-coverage",
    "media-workflow",
    "nextjs",
    "prisma",
    "ai-captioning"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Steve Stearn",
  "repository": {
    "type": "git",
    "url": "https://github.com/sterno/photoflow.git"
  },
  "bugs": {
    "url": "https://github.com/sterno/photoflow/issues"
  },
  "homepage": "https://github.com/sterno/photoflow#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:setup": "tsx scripts/setup.ts",
    "export:instance": "tsx scripts/export-instance.ts",
    "setup": "npm run db:generate && npm run db:migrate && npm run db:setup",
    "simulate": "node scripts/simulate-event.mjs",
    "viewer:install": "npm --prefix archive-viewer ci",
    "viewer:build": "npm --prefix archive-viewer install && npm --prefix archive-viewer run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1047.0",
    "@aws-sdk/lib-storage": "^3.1047.0",
    "@aws-sdk/s3-request-presigner": "^3.1047.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.3.0",
    "idb-keyval": "^6.2.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "next": "^16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.6",
    "resend": "^6.12.3",
    "sharp": "^0.34.3",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.6",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/unzipper": "^0.10.11",
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "jsdom": "^29.1.1",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.2",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "postcss": "^8.5.10"
  }
}
