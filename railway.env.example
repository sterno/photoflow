# PhotoFlow Prime — Railway service variables.
# Paste into the APP service's Variables → "Raw Editor". The description follows
# the `#` inline on each variable's line. Uses Railway syntax: ${{Service.VAR}},
# ${{VAR}} (same service), ${{secret(n)}}, ${{RAILWAY_PUBLIC_DOMAIN}}.

DATABASE_URL=${{Postgres.DATABASE_URL}} # PostgreSQL connection string — references the Postgres service.
AUTH_SECRET=${{secret(32)}} # Secret used to sign login sessions (auto-generated; keep private).
NEXTAUTH_SECRET=${{AUTH_SECRET}} # Must equal AUTH_SECRET — mirrors it automatically; no need to change.
NEXTAUTH_URL=https://${{RAILWAY_PUBLIC_DOMAIN}} # Public URL of the app — uses the domain Railway assigns to this service.
ADMIN_USERNAME=admin # Login name for the first admin account.
ADMIN_PASSWORD= # Password for the first admin account — at least 12 characters.
AWS_REGION=${{Bucket.REGION}} # Storage region — provided by the Bucket service.
AWS_S3_BUCKET=${{Bucket.BUCKET}} # Bucket name for uploaded photos — provided by the Bucket service.
AWS_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}} # Access key for the Bucket storage service.
AWS_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}} # Secret key for the Bucket storage service.
S3_ENDPOINT=${{Bucket.ENDPOINT}} # S3 endpoint — provided by the Bucket service.
S3_FORCE_PATH_STYLE=true # Use path-style addressing (required for MinIO/Bucket-style storage).
ANTHROPIC_API_KEY= # Optional — Anthropic API key to enable AI photo captions and people detection.
RESEND_API_KEY= # Optional — Resend API key to enable password-reset emails.
RESEND_FROM_EMAIL= # Optional — From address for password-reset emails (e.g. noreply@yourdomain.com).
